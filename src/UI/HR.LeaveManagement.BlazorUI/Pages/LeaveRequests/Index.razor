@page "/leaverequests/"
@attribute [Authorize]

<h3>Leave Requests</h3>

<AuthorizeView Roles="Employee">
    <div class="m-2 d-flex justify-content-end">
        <button class="btn btn-primary" @onclick="NavigateToCreate">Create Leave Request</button>
    </div>
</AuthorizeView>

<AuthorizeView Roles="Administrator">
    @if (LeaveRequests != null)
    {
        <div class="row g-3 my-2">
            <div class="col-md-4">
                <div class="card text-white bg-success text-center">
                    <div class="card-body">
                        <h2 class="card-title">@ApprovedCount</h2>
                        <p class="card-text">Approved</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-danger text-center">
                    <div class="card-body">
                        <h2 class="card-title">@RejectedCount</h2>
                        <p class="card-text">Rejected</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-dark bg-warning text-center">
                    <div class="card-body">
                        <h2 class="card-title">@PendingCount</h2>
                        <p class="card-text">Pending</p>
                    </div>
                </div>
            </div>
        </div>
    }
</AuthorizeView>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-danger">@Message</div>
}

@if (LeaveRequests == null)
{
    <p><em>Loading...</em></p>
}
else if (!LeaveRequests.Any())
{
    <p><em>No leave requests found.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Leave Type</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Date Requested</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var leaveRequest in LeaveRequests)
            {
                <tr>
                    <td>@leaveRequest.Id</td>
                    <td>@leaveRequest.LeaveType?.Name</td>
                    <td>@leaveRequest.StartDate?.ToShortDateString()</td>
                    <td>@leaveRequest.EndDate?.ToShortDateString()</td>
                    <td>@leaveRequest.DateRequested.ToShortDateString()</td>
                    <td><span class="badge @GetStatusCssClass(leaveRequest)">@leaveRequest.Status</span></td>
                    <td>
                        <AuthorizeView Roles="Employee">
                            @if (leaveRequest.Approved == null && !leaveRequest.Cancelled)
                            {
                                <button class="btn btn-sm btn-secondary" @onclick="() => NavigateToEdit(leaveRequest.Id)">Edit</button>
                            }
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteLeaveRequest(leaveRequest.Id)">Delete</button>
                        </AuthorizeView>
                        <button class="btn btn-sm btn-info" @onclick="() => NavigateToDetails(leaveRequest.Id)">Details</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
